# Local development works without external providers or DATABASE_URL.
# Set these before production. The initial owner is created only on an empty staff table.
DATABASE_URL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
BLOB_READ_WRITE_TOKEN=

# Outlook Calendar - Direct Booking Integration
#
# Bookings from the website are added directly to Bruton's Outlook calendar
# and an email invite is sent to the guest automatically.
#
# Setup (Azure AD App Registration):
#
# 1. Go to https://portal.azure.com → Azure Active Directory → App registrations
# 2. Click "New registration" → Name it "Bruton Gardens Booking" → Register
# 3. Copy the "Application (client) ID" and "Directory (tenant) ID"
# 4. Go to "Certificates & secrets" → New client secret → Copy the Value
# 5. Go to "API permissions" → Add permission → Microsoft Graph → Application permissions
#    → Add "Calendars.ReadWrite" → Click "Grant admin consent"
# 6. Set OUTLOOK_USER_EMAIL to Bruton's Outlook/Microsoft 365 email address

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
OUTLOOK_USER_EMAIL=

# Google Reviews - Display real Google reviews on the services page
#
# 1. Go to https://console.cloud.google.com/ → Create or select a project
# 2. Enable "Places API"
# 3. Go to "Credentials" → Create an API key
# 4. Find Bruton Gardens on Google Maps → copy the Place ID
#    (Use https://developers.google.com/maps/documentation/places/web-service/place-id)
# 5. Restrict the API key to "Places API" only for security

GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Paystack (MoMo + card, GHS) — online payments for apartment bookings.
# Until this is set, the booking page only offers "Pay on arrival".
# In the Paystack dashboard → Settings → API Keys & Webhooks, set the webhook URL to
#   https://brutongardens.com/api/payments/paystack/webhook
PAYSTACK_SECRET_KEY=

# Public site URL, used for the Paystack return link (defaults to the request origin)
SITE_URL=https://brutongardens.com

# SMS — Arkesel (https://arkesel.com → Dashboard → API keys). Sender ID must be approved by Arkesel, max 11 chars.
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=BrutonGdns
# ARKESEL_SANDBOX=true   # accept requests without actually sending (testing)

# Email — Resend (free plan). Verify brutongardens.com in Resend → Domains, then send from that domain.
RESEND_API_KEY=
# Until Resend is set up: send email from a Gmail account (needs 2-step verification + an app password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=Bruton Gardens <bookings@brutongardens.com>
EMAIL_REPLY_TO=info@brutongardens.com

# Vercel Cron auth for /api/cron/daily (any long random string; Vercel sends it automatically)
CRON_SECRET=
