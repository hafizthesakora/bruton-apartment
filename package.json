    "@radix-ui/react-slot": "^1.1.2",
    "@vercel/blob": "^2.3.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "fflate": "0.8.2",
    "framer-motion": "^12.34.0",
    "jose": "^6.2.2",
    "lenis": "^1.3.4",
    "lucide-react": "^0.481.0",
    "mongodb": "^7.1.1",
    "next": "15.2.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
